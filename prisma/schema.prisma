generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ReviewMode {
  STRICT
  MODERATE
  ACCEPTABLE
}

enum Severity {
  CRITICAL
  MAJOR
}

enum IssueCategory {
  GRAMMAR
  FORMAT
  COMPLETENESS
  SECTION_QUALITY
  OTHER
}

enum IssueSource {
  AGENT
  REVIEWER
  RULE
}

enum ReportStatus {
  UPLOADED
  REVIEWING
  REVIEWED
  APPROVED
  SENT
}

enum SampleQuality {
  EXCELLENT
  BAD
}

model Report {
  id            String       @id @default(cuid())
  filename      String
  originalPath  String
  htmlContent   String
  plainText     String
  offsetMap     Json
  studentName   String?
  studentEmail  String?
  reviewMode    ReviewMode   @default(MODERATE)
  markingMode   ReviewMode   @default(MODERATE)
  marking       Json?
  status        ReportStatus @default(UPLOADED)
  templateId    String?
  template      KbTemplate?  @relation(fields: [templateId], references: [id], onDelete: SetNull)
  enabledSkills String[]     @default([])
  reviewStartedAt DateTime?
  reviewProgress  Json?
  wordCountMin    Int          @default(8000)
  wordCountMax    Int          @default(12000)
  issues        Issue[]
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([studentName])
  @@index([status])
  @@index([createdAt])
}

model Issue {
  id               String        @id @default(cuid())
  reportId         String
  report           Report        @relation(fields: [reportId], references: [id], onDelete: Cascade)
  startOffset      Int
  endOffset        Int
  anchorPath       String?
  quotedText       String
  severity         Severity
  category         IssueCategory
  shortDescription String
  source           IssueSource   @default(AGENT)
  deleted          Boolean       @default(false)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([reportId])
}

model KbTemplate {
  id            String   @id @default(cuid())
  name          String
  filePath      String
  htmlContent   String
  plainText     String
  // Auto-generated marking scheme derived from the template's headings and
  // required word-count band. Computed once per template (and on demand when
  // missing) and used as the deterministic baseline for the report marking.
  markingScheme Json?
  reports       Report[]
  createdAt     DateTime @default(now())
}

// Cross-report dismissal learning. Each time a reviewer deletes an issue we
// upsert a row keyed by a normalized form of the shortDescription. Once the
// same pattern is dismissed >= LEARNED_REJECTION_THRESHOLD times across any
// reports we treat it as a global "don't flag this kind of thing" hint and
// inject it into the agent's system prompt on future reviews.
model LearnedRejection {
  id             String         @id @default(cuid())
  normalizedDesc String         @unique
  sampleDesc     String
  sampleQuoted   String
  category       IssueCategory
  hitCount       Int            @default(1)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([hitCount])
}

model KbSample {
  id          String        @id @default(cuid())
  name        String
  quality     SampleQuality
  filePath    String
  htmlContent String
  plainText   String
  summary     String?
  createdAt   DateTime      @default(now())

  @@index([quality])
}
